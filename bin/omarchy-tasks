#!/usr/bin/env python3
"""Read and edit Obsidian Tasks-format checkboxes in a vault.

Kept deliberately small: the QML widget owns presentation, this owns every
touch of the vault. Every write is a compare-and-swap on the exact line text
rather than a line number, because Obsidian Sync can rewrite a file between
the scan that drew a row and the click that acts on it.
"""
import json
import os
import re
import subprocess
import sys
from datetime import date, timedelta

DUE, DONE, CREATED, SCHEDULED, START = "\U0001F4C5", "✅", "➕", "⏳", "\U0001F6EB"
PRIORITY = {"\U0001F53A": 0, "\U000023EB": 1, "\U0001F53C": 2, "\U0001F53D": 4, "\U000023EC": 5}
# Every signifier Obsidian Tasks defines, whether or not this tool reads it.
# The list exists so a rename can find where the description ends and leave
# metadata it doesn't understand untouched rather than eating it.
SIGNIFIERS = [DUE, DONE, CREATED, SCHEDULED, START, "❌", "\U0001F501",
              "\U0001F194", "⛔", "\U0001F6AB"] + list(PRIORITY)
TASK_RE = re.compile(r"^(?P<indent>\s*)(?P<bullet>[-*+])\s\[(?P<status>.)\]\s(?P<body>.*)$")
DATE_RE = r"(\d{4}-\d{2}-\d{2})"
EXCLUDES = ["!.obsidian", "!.trash", "!Templates", "!.git"]
WEEKDAYS = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]


# ----------------------------------------------------------------- primitives

def split_body(body):
    """Split a task body into (description, metadata).

    The description runs up to the first signifier; everything from there on is
    metadata that edits must preserve verbatim.
    """
    cut = len(body)
    for glyph in SIGNIFIERS:
        found = body.find(glyph)
        if found != -1:
            cut = min(cut, found)
    return body[:cut].strip(), body[cut:].strip()


def rewrite(path, exact, transform):
    """Apply `transform(status, description, metadata)` to the line matching
    `exact`, which must return the replacement (status, description, metadata).

    No match means the vault moved under us: a no-op rather than a guess at
    which line was meant. Returns 0 when a line was rewritten.
    """
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().split("\n")
    except OSError:
        return 1
    for index, line in enumerate(lines):
        if line != exact:
            continue
        match = TASK_RE.match(line)
        if not match:
            return 1
        description, metadata = split_body(match.group("body"))
        result = transform(match.group("status"), description, metadata)
        if result is None:
            return 1
        status, description, metadata = result
        body = " ".join(part for part in (description, metadata) if part)
        lines[index] = f'{match.group("indent")}{match.group("bullet")} [{status}] {body}'
        with open(path, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines))
        # Echoed so the caller can address the line it just created — undo needs
        # the completed text, which is no longer the text it clicked.
        print(lines[index])
        return 0
    return 1


def strip_signifier(metadata, glyph, dated=True):
    pattern = re.escape(glyph) + (r"\s*" + DATE_RE + r"?" if dated else "")
    return " ".join(re.sub(pattern, "", metadata).split())


# ------------------------------------------------------------------- commands

def scan(vault):
    args = ["rg", "--no-heading", "--with-filename", "--line-number", "--no-messages",
            "-e", r"^\s*[-*+] \[.\] "]
    for glob in EXCLUDES:
        args += ["-g", glob]
    args.append(vault)
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []

    tasks = []
    for entry in out.splitlines():
        path, _, rest = entry.partition(":")
        lineno, _, raw = rest.partition(":")
        match = TASK_RE.match(raw)
        if not match:
            continue
        body, status = match.group("body"), match.group("status")
        description, metadata = split_body(body)
        due = re.search(re.escape(DUE) + r"\s*" + DATE_RE, metadata)
        tasks.append({
            "file": path,
            "line": int(lineno) if lineno.isdigit() else 0,
            "raw": raw,
            "label": description,
            "due": due.group(1) if due else "",
            "priority": next((rank for glyph, rank in PRIORITY.items() if glyph in metadata), 3),
            "open": status == " ",
            "vaultPath": os.path.relpath(path, vault),
        })
    return tasks


def complete(path, exact):
    def transform(status, description, metadata):
        if status != " ":
            return None
        if DONE not in metadata:
            metadata = f"{metadata} {DONE} {date.today().isoformat()}".strip()
        return "x", description, metadata
    return rewrite(path, exact, transform)


def uncomplete(path, exact):
    def transform(status, description, metadata):
        if status == " ":
            return None
        return " ", description, strip_signifier(metadata, DONE)
    return rewrite(path, exact, transform)


def rename(path, exact, text):
    text = " ".join(text.split())
    if not text:
        return 1

    def transform(status, description, metadata):
        # A rename that reintroduces a date phrase should move the due date too,
        # so editing text behaves the same as typing it in the add box.
        body, due = extract_due(text)
        if not body:
            return None
        if due:
            metadata = f"{strip_signifier(metadata, DUE)} {DUE} {due}".strip()
        return status, body, metadata
    return rewrite(path, exact, transform)


def extract_due(text):
    """Pull a trailing date phrase off a task description.

    Only trailing phrases count. "call bank friday" sets a date; "friday night
    drinks" keeps its words, because stripping mid-sentence would quietly
    rewrite what the task says.
    """
    today = date.today()
    patterns = [
        (r"\s+(\d{4}-\d{2}-\d{2})$", lambda m: m.group(1)),
        (r"\s+today$", lambda m: today.isoformat()),
        (r"\s+(?:tomorrow|tmrw)$", lambda m: (today + timedelta(days=1)).isoformat()),
        (r"\s+next\s+week$", lambda m: (today + timedelta(days=7)).isoformat()),
        (r"\s+in\s+(\d+)\s+days?$", lambda m: (today + timedelta(days=int(m.group(1)))).isoformat()),
        (r"\s+in\s+(\d+)\s+weeks?$", lambda m: (today + timedelta(weeks=int(m.group(1)))).isoformat()),
        # Full names stand alone; the short forms need an explicit "on" or
        # "next". Bare "sun", "sat" and "mon" are ordinary words, and matching
        # them ate the last word of tasks like "photograph the sun".
        (r"\s+(?:on\s+|next\s+)?(" + "|".join(WEEKDAYS) + r")$",
         lambda m: weekday_ahead(m.group(1))),
        (r"\s+(?:on|next)\s+(mon|tues?|weds?|thurs?|fri|sat|sun)$",
         lambda m: weekday_ahead(m.group(1))),
    ]
    for pattern, resolve in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            return text[:match.start()].strip(), resolve(match)
    return text.strip(), ""


def weekday_ahead(prefix):
    today = date.today()
    stem = prefix.lower()[:3]
    target = next(i for i, name in enumerate(WEEKDAYS) if name.startswith(stem))
    ahead = (target - today.weekday()) % 7
    # Naming today's weekday means the next one, not zero days away.
    return (today + timedelta(days=ahead or 7)).isoformat()


def add(path, text):
    text, due = extract_due(" ".join(text.split()))
    if not text:
        return 1
    os.makedirs(os.path.dirname(path), exist_ok=True)
    existing = ""
    if os.path.exists(path):
        with open(path, encoding="utf-8") as handle:
            existing = handle.read()
    # TaskForge leaves its file without a trailing newline; appending blind
    # would weld the new task onto the last one and lose both.
    prefix = "" if (not existing or existing.endswith("\n")) else "\n"
    trailer = f" {DUE} {due}" if due else ""
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(f"{prefix}- [ ] {text} {CREATED} {date.today().isoformat()}{trailer}\n")
    return 0


def main():
    if len(sys.argv) < 3:
        print("usage: omarchy-tasks scan <vault> | complete|uncomplete <file> <line> "
              "| rename <file> <line> <text> | add <file> <text>", file=sys.stderr)
        return 2
    action, args = sys.argv[1], sys.argv[2:]
    if action == "scan":
        json.dump(scan(args[0]), sys.stdout)
        return 0
    if action == "complete" and len(args) >= 2:
        return complete(args[0], args[1])
    if action == "uncomplete" and len(args) >= 2:
        return uncomplete(args[0], args[1])
    if action == "rename" and len(args) >= 3:
        return rename(args[0], args[1], " ".join(args[2:]))
    if action == "add" and len(args) >= 2:
        return add(args[0], " ".join(args[1:]))
    return 2


if __name__ == "__main__":
    sys.exit(main())
